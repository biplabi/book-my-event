# Copy to .env.local and adjust as needed.

# Dev-server proxy target for /api/* (user-service). Not exposed to the browser.
USER_SERVICE_URL=http://localhost:8081

# Dev-server proxy target for /event-service/* (event-service).
EVENT_SERVICE_URL=http://localhost:8082

# Dev-server proxy target for /booking-service/* (booking-service).
BOOKING_SERVICE_URL=http://localhost:8083

# Base URL the browser uses for API calls. Leave empty to go through the
# dev-server proxy (or a reverse proxy in production).
VITE_API_BASE_URL=
